{
  "scopeName": "source.cez",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#console"
    },
    {
      "include": "#declarations"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.cez",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cez",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cez",
              "match": "\\\\\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.cez",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.cez",
      "match": "\\\\b(clase|class|funcion|function|retornar|return|si|sino|sino_si|mientras|para|en|romper|continuar|y|o|no|es)\\\\b"
    },
    "constants": {
      "name": "constant.language.cez",
      "match": "\\b(verdadero|falso|nada|yo)\\b"
    },
    "functions": {
      "name": "support.function.cez",
      "match": "\\\\b(mostrar|entrada|tipo|rango|longitud|main)\\\\b"
    },
    "console": {
      "patterns": [
        {
          "name": "support.type.cez",
          "match": "\\\\b(consola|console)\\\\b"
        },
        {
          "name": "support.function.cez",
          "match": "\\\\b(escribir|log|error|advertir|warn|limpiar)\\\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "entity.name.function.cez",
          "match": "(?<=funcion )\\\\w+"
        },
        {
          "name": "entity.name.function.cez",
          "match": "(?<=function )\\\\w+"
        },
        {
          "name": "entity.name.class.cez",
          "match": "(?<=clase )\\\\w+"
        }
      ]
    }
  }
}