{
  "name": "cez-language",
  "displayName": "C ez Language Support",
  "description": "Lenguaje C ez con main(), consola, importación de módulos, autocompletado e intérprete integrado.",
  "version": "0.4.0",
  "publisher": "sbtias",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:cez"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cez",
        "aliases": [
          "C ez",
          "cez"
        ],
        "extensions": [
          ".cez"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cez",
        "scopeName": "source.cez",
        "path": "./syntaxes/cez.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "cez.runFile",
        "title": "C ez: Ejecutar archivo",
        "icon": "$(play)"
      },
      {
        "command": "cez.newFile",
        "title": "C ez: Crear archivo .cez"
      },
      {
        "command": "cez.showLanguageInfo",
        "title": "C ez: Ver funciones del lenguaje"
      },
      {
        "command": "cez.clearErrors",
        "title": "C ez: Limpiar errores y salida"
      }
    ],
    "keybindings": [
      {
        "command": "cez.runFile",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorTextFocus && editorLangId == cez"
      }
    ],
    "snippets": [
      {
        "language": "cez",
        "path": "./snippets/cez.json"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cez.runFile",
          "when": "editorLangId == cez",
          "group": "navigation",
          "alt": "cez.runFile"
        },
        {
          "command": "cez.newFile",
          "when": "editorLangId == cez",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "cez.runFile"
        },
        {
          "command": "cez.newFile"
        },
        {
          "command": "cez.clearErrors"
        },
        {
          "command": "cez.showLanguageInfo"
        }
      ]
    },
    "iconThemes": [
      {
        "id": "cez-file-icons",
        "label": "C ez File Icons",
        "path": "./icons/cez-icon-theme.json"
      }
    ]
  },
  "files": [
    "extension.js",
    "runtime.js",
    "language-configuration.json",
    "syntaxes/**",
    "snippets/**",
    "README.md"
  ],
  "scripts": {
    "vscode:prepublish": "node --check extension.js && node --check runtime.js"
  }
}
