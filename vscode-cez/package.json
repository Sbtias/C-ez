{
  "name": "cez-language",
  "displayName": "C ez Language Support",
  "description": "Lenguaje C ez con intérprete integrado, resaltado, snippets y ejecución sin dependencias externas.",
  "version": "0.2.0",
  "publisher": "sbtias",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:cez"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cez",
        "aliases": [
          "C ez",
          "cez"
        ],
        "extensions": [
          ".cez"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cez",
        "scopeName": "source.cez",
        "path": "./syntaxes/cez.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "cez.runFile",
        "title": "C ez: Ejecutar archivo"
      },
      {
        "command": "cez.newFile",
        "title": "C ez: Crear archivo .cez"
      },
      {
        "command": "cez.showLanguageInfo",
        "title": "C ez: Ver funciones del lenguaje"
      }
    ],
    "keybindings": [
      {
        "command": "cez.runFile",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorTextFocus && editorLangId == cez"
      }
    ],
    "snippets": [
      {
        "language": "cez",
        "path": "./snippets/cez.json"
      }
    ]
  },
  "files": [
    "extension.js",
    "runtime.js",
    "language-configuration.json",
    "syntaxes/**",
    "snippets/**",
    "README.md"
  ],
  "scripts": {
    "vscode:prepublish": "node --check extension.js && node --check runtime.js"
  }
}
